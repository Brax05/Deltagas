# ==============================================================================
# Aplicación de apoyo al cálculo de redes de gas (DS 66)
# Copia este archivo a .env.local para desarrollo local.
# NUNCA expongas claves secretas con prefijo NEXT_PUBLIC_.
# ==============================================================================

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (público — seguro para navegador bajo RLS estricto)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Supabase Administración (SOLO SERVIDOR — nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Servicio de visión / lectura de fichas técnicas (SOLO SERVIDOR - Sección 12 y 13.4)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-20250514
VISION_DAILY_USER_LIMIT=25

# Correo SMTP propio (configurado también en Supabase Auth - Sección 13.2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RedGas DS66 <no-reply@tu-dominio.cl>"

# Asistente Chat IA de Ultra Bajo Costo y Alta Escalabilidad (SOLO SERVIDOR salvo NEXT_PUBLIC_)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CHAT_ALLOWED_ORIGINS=http://localhost:3000
CHAT_CACHE_TTL_SECONDS=172800
CHAT_RATE_LIMIT_PER_MIN=5
CHAT_RATE_LIMIT_PER_DAY=20
CHAT_AI_TIMEOUT_MS=5000
NEXT_PUBLIC_CHAT_FALLBACK_CONTACT_URL=

